#!/usr/bin/env bash
#
# git ci — submit the current tree to a CI orchestrator.
#
# Installed onto PATH as `git-ci`, which is what makes `git ci` work: git runs
# any `git-<name>` on PATH as a subcommand.
#
# What it sends is a `git archive` tarball of the tree you asked for, signed with
# HMAC-SHA256. That means no repository credential exists on the server or in a
# build VM — you already had read access, so nothing else needs it. It also means
# what runs is exactly what you submitted, rather than whatever a ref resolved to
# by the time the server got around to cloning it.
#
# Usage:
#   git ci                     submit HEAD
#   git ci --dirty             include uncommitted tracked changes
#   git ci --ref <rev>         submit some other commit
#   git ci --workflow <id>     name the workflow object this run belongs to
#   git ci --dry-run           print what would be sent, send nothing
#   git ci --upgrade           reinstall from the release channel
#
# Configuration, in order of precedence:
#   CI_ENDPOINT      / git config ci.endpoint     the /api/submit URL
#   CI_WEBHOOK_SECRET / git config ci.secret      the HMAC secret
set -euo pipefail

GIT_CI_VERSION="0.1.0"

die() { printf 'git ci: %s\n' "$*" >&2; exit 1; }

# --- argument parsing -------------------------------------------------------

rev="HEAD"
dirty=0
dry_run=0
workflow=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dirty)    dirty=1; shift ;;
    --dry-run)  dry_run=1; shift ;;
    --ref)      rev="${2:?--ref needs a revision}"; shift 2 ;;
    --workflow) workflow="${2:?--workflow needs an id}"; shift 2 ;;
    --upgrade)
      installer="${CI_INSTALL_URL:-https://heyo-cli-releases.s3.amazonaws.com/git-ci/latest/install-git-ci.sh}"
      command -v curl >/dev/null 2>&1 || die "--upgrade needs curl"
      curl --fail --show-error --silent --location "$installer" \
        | CI_INSTALL_SOURCE=remote bash
      exit $?
      ;;
    --version)  printf '%s\n' "$GIT_CI_VERSION"; exit 0 ;;
    -h|--help)  sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)          die "unknown argument $1 (try --help)" ;;
  esac
done

for tool in git curl openssl base64; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is required but not on PATH"
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# --- configuration ----------------------------------------------------------

endpoint="${CI_ENDPOINT:-$(git config --get ci.endpoint || true)}"
[ -n "$endpoint" ] || die "no endpoint. Set CI_ENDPOINT or run:
    git config ci.endpoint https://ci.example.com/api/submit"
case "$endpoint" in
  */api/submit) ;;
  */)           endpoint="${endpoint}api/submit" ;;
  *)            endpoint="${endpoint}/api/submit" ;;
esac

secret="${CI_WEBHOOK_SECRET:-$(git config --get ci.secret || true)}"
[ -n "$secret" ] || die "no signing secret. Set CI_WEBHOOK_SECRET, or:
    git config ci.secret <the server's CI_WEBHOOK_SECRET>"

# --- what to submit ---------------------------------------------------------

sha="$(git rev-parse --verify "$rev^{commit}" 2>/dev/null)" \
  || die "cannot resolve $rev to a commit"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
[ "$branch" = "HEAD" ] && branch="detached"
repo_url="$(git config --get remote.origin.url || echo "")"
repo_name="$(basename "$(git rev-parse --show-toplevel)")"
default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
before="$(git rev-parse --verify "${rev}^" 2>/dev/null || echo "")"
pusher_name="$(git config --get user.name || echo "")"
pusher_email="$(git config --get user.email || echo "")"

work="$(mktemp -d "${TMPDIR:-/tmp}/git-ci.XXXXXX")"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT

tarball="$work/source.tar.gz"

if [ "$dirty" -eq 1 ]; then
  # Build a throwaway commit from the index plus the worktree, so uncommitted
  # tracked changes are included without touching the real index or HEAD. The
  # separate GIT_INDEX_FILE is what keeps `git ci --dirty` from staging anything
  # in the user's actual repository.
  export GIT_INDEX_FILE="$work/index"
  git read-tree "$sha"
  git add -u
  tree="$(git write-tree)"
  unset GIT_INDEX_FILE
  git archive --format=tar.gz -o "$tarball" "$tree"
  sha="$sha-dirty"
else
  git archive --format=tar.gz -o "$tarball" "$sha"
fi

size="$(wc -c < "$tarball" | tr -d ' ')"

if [ "$dry_run" -eq 1 ]; then
  printf 'would submit to %s\n' "$endpoint"
  printf '  repository %s (%s)\n' "$repo_name" "${repo_url:-no remote}"
  printf '  ref        refs/heads/%s\n' "$branch"
  printf '  commit     %s\n' "$sha"
  printf '  archive    %s bytes%s\n' "$size" "$([ "$dirty" -eq 1 ] && echo ' (including uncommitted changes)')"
  [ -n "$workflow" ] && printf '  workflow   %s\n' "$workflow"
  printf '  files:\n'
  tar -tzf "$tarball" | head -20 | sed 's/^/    /'
  exit 0
fi

# --- payload ----------------------------------------------------------------

payload="$work/payload.json"

# `base64 -w0` is GNU; BSD/macOS base64 wraps by default and has no -w. Piping
# through tr removes the newlines either way.
b64="$(base64 < "$tarball" | tr -d '\n')"

if command -v jq >/dev/null 2>&1; then
  jq -n \
    --arg id "$repo_name" --arg name "$repo_name" --arg url "$repo_url" \
    --arg db "$default_branch" --arg ref "refs/heads/$branch" \
    --arg before "$before" --arg after "$sha" \
    --arg pn "$pusher_name" --arg pe "$pusher_email" \
    --arg wf "$workflow" --arg content "$b64" \
    '{repository:{id:$id,name:$name,url:$url,defaultBranch:(if $db=="" then null else $db end)},
      ref:$ref, before:$before, after:$after, dryRun:false,
      pusher:{name:$pn,email:$pe},
      workflowId:(if $wf=="" then null else $wf end),
      source:{format:"tar.gz", contentBase64:$content}}' > "$payload"
else
  # jq is not universally installed and this payload is simple enough to build
  # by hand. Only the free-text fields need escaping; the rest are shas, refs and
  # base64.
  esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
  {
    printf '{"repository":{"id":"%s","name":"%s","url":"%s","defaultBranch":%s},' \
      "$(esc "$repo_name")" "$(esc "$repo_name")" "$(esc "$repo_url")" \
      "$([ -n "$default_branch" ] && printf '"%s"' "$(esc "$default_branch")" || printf 'null')"
    printf '"ref":"refs/heads/%s","before":"%s","after":"%s","dryRun":false,' \
      "$(esc "$branch")" "$before" "$sha"
    printf '"pusher":{"name":"%s","email":"%s"},' "$(esc "$pusher_name")" "$(esc "$pusher_email")"
    printf '"workflowId":%s,' \
      "$([ -n "$workflow" ] && printf '"%s"' "$(esc "$workflow")" || printf 'null')"
    printf '"source":{"format":"tar.gz","contentBase64":"%s"}}' "$b64"
  } > "$payload"
fi

signature="sha256=$(openssl dgst -sha256 -hmac "$secret" -binary < "$payload" | xxd -p -c 256 | tr -d '\n')"

response="$work/response.json"
code="$(curl --silent --show-error --output "$response" --write-out '%{http_code}' \
  --max-time "${CI_SUBMIT_TIMEOUT:-300}" \
  -X POST "$endpoint" \
  -H 'content-type: application/json' \
  -H "x-heyo-signature-256: $signature" \
  -H "x-heyo-git-ci-version: $GIT_CI_VERSION" \
  --data-binary "@$payload")" || die "could not reach $endpoint"

if [ "$code" -ge 400 ]; then
  if command -v jq >/dev/null 2>&1 && jq -e . "$response" >/dev/null 2>&1; then
    jq -r '.error // .' "$response" >&2
  else
    cat "$response" >&2; printf '\n' >&2
  fi
  die "submit rejected (HTTP $code)"
fi

printf 'submitted %s on %s (%s bytes)\n' "${sha:0:12}" "$branch" "$size"
if command -v jq >/dev/null 2>&1 && jq -e . "$response" >/dev/null 2>&1; then
  base="$(jq -r '.url // ""' "$response")"
  jq -r '.runs[]' "$response" 2>/dev/null | while read -r run; do
    printf '  run %s  %sruns/%s\n' "$run" "$base" "$run"
  done
else
  cat "$response"
fi
